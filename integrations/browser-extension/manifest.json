{
  "manifest_version": 3,
  "name": "OpenRGB 3D Spatial - Movie Sync",
  "version": "0.4.1",
  "description": "Plays OpenRGB 3D Spatial Movie Sync cues in time with Netflix, Prime Video, Crunchyroll and more. Talks only to OpenRGB on this PC.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OpenRGB Movie Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.com.au/gp/video/*",
        "https://www.amazon.ca/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*",
        "https://www.disneyplus.com/*",
        "https://www.stan.com.au/*",
        "https://play.stan.com.au/*",
        "https://binge.com.au/*",
        "https://www.binge.com.au/*",
        "https://www.youtube.com/*",
        "https://www.paramountplus.com/*",
        "https://play.max.com/*",
        "https://www.max.com/*",
        "https://tv.apple.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "page-netflix.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.com.au/gp/video/*",
        "https://www.amazon.ca/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": [
        "page-hooks.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "movie-sync@openrgb3dspatial",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "111"
}
