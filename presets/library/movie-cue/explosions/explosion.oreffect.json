// =============================================================================
// Movie Cue look â€” explosions/explosion
// Layout follows library/movie-cue/_template.oreffect.json
// (same openrgb3d.effect_pack v4 sections as library/packs/_template.oreffect.json)
// =============================================================================
{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.effect_pack",
  "version": 4,
  "id": "explosion",
  "name": "Explosion",

  // --- Playback --------------------------------------------------------------
  "duration_ms": 1600,
  "loop": "once",
  "priority": 40,

  // --- Tracks ----------------------------------------------------------------
  "tracks": [
    {
      "name": "All LEDs",
      "target": { "kind": "all" },
      "blocks": [
        {
          // --- Block look / type ---------------------------------------------
          "type": "burst",
          "effect": "burst",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 1600,

          // --- Brightness ----------------------------------------------------
          "intensity": 0.85,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#FF2800",
          "color_from": "#140000",
          "color_to": "#FFFFB4",
          "gradient": [
            { "pos": 0.0, "color": "#140000" },
            { "pos": 0.35, "color": "#FF2800" },
            { "pos": 0.7, "color": "#FFA000" },
            { "pos": 1.0, "color": "#FFFFB4" }
          ],

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "room",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.2,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
