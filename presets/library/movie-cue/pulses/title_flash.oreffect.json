// =============================================================================
// Movie Cue look â€” pulses/title_flash
// Photosensitive â€” catalog marks photosensitive:true; needs Allow strobe checked.
// Layout follows library/movie-cue/_template.oreffect.json
// =============================================================================
{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.effect_pack",
  "version": 4,
  "id": "title_flash",
  "name": "Title flash",

  // --- Playback --------------------------------------------------------------
  "duration_ms": 900,
  "loop": "once",
  "priority": 50,

  // --- Tracks ----------------------------------------------------------------
  "tracks": [
    {
      "name": "All LEDs",
      "target": { "kind": "all" },
      "blocks": [
        {
          // --- Block look / type ---------------------------------------------
          "type": "pulse",
          "effect": "pulse",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 900,

          // --- Brightness ----------------------------------------------------
          "intensity": 0.75,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#FFFFFF",
          "color_from": "#FFFFFF",
          "color_to": "#FFFFFF",

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "room",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.08,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
