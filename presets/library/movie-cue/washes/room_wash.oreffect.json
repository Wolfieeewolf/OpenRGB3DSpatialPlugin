// =============================================================================
// Movie Cue look â€” washes/room_wash
// Layout follows library/movie-cue/_template.oreffect.json
// =============================================================================
{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.effect_pack",
  "version": 4,
  "id": "room_wash",
  "name": "Room wash",

  // --- Playback --------------------------------------------------------------
  // while_active: keeps washing while the Movie Cue level holds this look
  "duration_ms": 8000,
  "loop": "while_active",
  "priority": 18,

  // --- Tracks ----------------------------------------------------------------
  "tracks": [
    {
      "name": "All LEDs",
      "target": { "kind": "all" },
      "blocks": [
        {
          // --- Block look / type ---------------------------------------------
          "type": "solid",
          "effect": "solid",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 8000,

          // --- Brightness ----------------------------------------------------
          "intensity": 0.7,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#145AAA",
          "color_from": "#145AAA",
          "color_to": "#FFFFFF",

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "room",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.25,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
