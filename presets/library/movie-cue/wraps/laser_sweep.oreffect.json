{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.effect_pack",
  "version": 4,
  "id": "laser_sweep",
  "name": "Laser sweep",

  // --- Playback --------------------------------------------------------------
  "duration_ms": 1800,
  "loop": "once",
  "priority": 35,

  // --- Tracks ----------------------------------------------------------------
  "tracks": [
    {
      "name": "All LEDs",
      "target": { "kind": "all" },
      "blocks": [
        {
          // --- Block look / type ---------------------------------------------
          "type": "wipe",
          "effect": "wipe",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 1800,

          // --- Brightness ----------------------------------------------------
          "intensity": 0.8,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#00FFFF",
          "color_from": "#001133",
          "color_to": "#FFFFFF",
          "gradient": [
            { "pos": 0.0, "color": "#001133" },
            { "pos": 0.45, "color": "#00E5FF" },
            { "pos": 1.0, "color": "#FFFFFF" }
          ],

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "room",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.25,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
