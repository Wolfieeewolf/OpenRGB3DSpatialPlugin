// =============================================================================
// Effect pack template  (openrgb3d.effect_pack v4)
// Copy this file, rename it, then edit the values below.
// Same schema for library/packs/ (Effect Pack maker) and library/movie-cue/ (Movie Cue).
// Comments are supported when loading (.oreffect.json). Saving from the in-app
// editor rewrites the file without comments but keeps this field order.
// =============================================================================
{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.effect_pack",
  "version": 4,
  "id": "my_effect_id",
  "name": "My Effect Name",

  // --- Playback --------------------------------------------------------------
  // duration_ms: 1..60000
  // loop: once | forever | while_active  (Movie Cue level holds use while_active)
  // priority: higher wins when packs overlap the same LEDs
  "duration_ms": 2000,
  "loop": "once",
  "priority": 20,

  // Optional: limit to named scene controllers. Omit or [] = all devices.
  // "devices": ["Keyboard", "Mouse"],

  // --- Tracks ----------------------------------------------------------------
  // One track = one target + a timeline of blocks.
  "tracks": [
    {
      "name": "All LEDs",
      "target": {
        // kind: all | device | zone | leds | scene_zone
        "kind": "all"
        // "device_name": "Keyboard",
        // "zone_name": "Main",
        // "scene_zone_name": "Desk",
        // "flatten_leds": true
      },
      "blocks": [
        {
          // --- Block look / type ---------------------------------------------
          // type/effect: stem of a library/packs/blocks/**/*.fx file
          //   basic:  solid, fade, pulse, wipe, chase, wave, …
          //   volume: burst, ripple, spherewipe, noise3d, …
          "type": "burst",
          "effect": "burst",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 2000,

          // --- Brightness ----------------------------------------------------
          "intensity": 0.85,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#FF2800",
          "color_from": "#140000",
          "color_to": "#FFFFB4",
          "gradient": [
            { "pos": 0.0, "color": "#140000" },
            { "pos": 0.35, "color": "#FF2800" },
            { "pos": 0.7, "color": "#FFA000" },
            { "pos": 1.0, "color": "#FFFFB4" }
          ],

          // --- Motion / space ------------------------------------------------
          // axis_space: room | device | sequence
          "direction": "right",
          "axis_space": "room",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.2,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
