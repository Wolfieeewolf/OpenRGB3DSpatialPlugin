{
  // --- Pack identity ---------------------------------------------------------
  "format": "openrgb3d.effect_pack",
  "version": 4,
  "id": "sequence_wipe",
  "name": "Sequence wipe",

  // --- Playback --------------------------------------------------------------
  "duration_ms": 3000,
  "loop": "once",
  "priority": 15,

  // --- Tracks ----------------------------------------------------------------
  "tracks": [
    {
      "name": "All LEDs",
      "target": { "kind": "all" },
      "blocks": [
        {
          // --- Block look / type ---------------------------------------------
          "type": "wipe",
          "effect": "wipe",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 0,
          "end_ms": 2200,

          // --- Brightness ----------------------------------------------------
          "intensity": 1.0,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#281450",
          "color_from": "#281450",
          "color_to": "#FFF0C8",
          "gradient": [
            { "pos": 0.0, "color": "#281450" },
            { "pos": 0.4, "color": "#FF5028" },
            { "pos": 0.75, "color": "#FFB43C" },
            { "pos": 1.0, "color": "#FFF0C8" }
          ],

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "sequence",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.25,
          "period_ms": 1000,
          "reverse": false,

          // Optional: intensity over block progress
          "intensity_curve": [
            { "pos": 0.0, "value": 1.0 },
            { "pos": 0.4, "value": 0.75 },
            { "pos": 1.0, "value": 0.0 }
          ]
        },
        {
          // --- Block look / type ---------------------------------------------
          "type": "scanner",
          "effect": "scanner",

          // --- Timing within the pack ----------------------------------------
          "start_ms": 400,
          "end_ms": 3000,

          // --- Brightness ----------------------------------------------------
          "intensity": 1.0,
          "min_intensity": 0.15,
          "max_intensity": 1.0,

          // --- Colour --------------------------------------------------------
          "color": "#140000",
          "color_from": "#140000",
          "color_to": "#FFFFB4",
          "gradient": [
            { "pos": 0.0, "color": "#140000" },
            { "pos": 0.35, "color": "#FF2800" },
            { "pos": 0.7, "color": "#FFA000" },
            { "pos": 1.0, "color": "#FFFFB4" }
          ],

          // --- Motion / space ------------------------------------------------
          "direction": "right",
          "axis_space": "sequence",
          "axis_mode": "preset",
          "axis_yaw_deg": 0.0,
          "axis_pitch_deg": 0.0,
          "speed": 1.0,
          "pulse_length": 0.12,
          "period_ms": 1000,
          "reverse": false
        }
      ]
    }
  ]
}
