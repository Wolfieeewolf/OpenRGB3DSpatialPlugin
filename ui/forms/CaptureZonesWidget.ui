    <widget class="QGroupBox" name="zonesGroup">
     <property name="title">
      <string>Capture Zones</string>
     </property>
     <property name="toolTip">
      <string>Only LEDs whose screen direction lands in an enabled zone stay lit (and sample that UV). Separate zones do not fill the gaps between them — left+right strips leave the middle dark.</string>
     </property>
     <layout class="QVBoxLayout" name="zonesLayout">
      <item>
       <layout class="QHBoxLayout" name="zoneButtonsRow">
