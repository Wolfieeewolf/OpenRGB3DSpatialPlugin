<ui version="4.0">
 <class>ScreenMirrorCapturePanel</class>
 <widget class="QWidget" name="ScreenMirrorCapturePanel">
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <widget class="QGroupBox" name="statusGroup">
     <property name="title">
      <string>Multi-Monitor Status</string>
     </property>
     <layout class="QVBoxLayout" name="statusLayout">
      <item>
       <widget class="QLabel" name="statusInfoLabel">
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="text">
         <string>Each display plane picks a screen capture source (Monitor 1, Monitor 2, …). Assign it here or on the plane in Object Creator / Scene object edit — same setting.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="monitorStatusLabel">
        <property name="text">
         <string>Calculating...</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="captureGroup">
     <property name="title">
      <string>Capture Quality</string>
     </property>
     <layout class="QVBoxLayout" name="captureLayout">
      <item>
       <layout class="QHBoxLayout" name="qualityRow">
        <item>
         <widget class="QLabel" name="qualityCaption">
          <property name="text">
           <string>Resolution:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="captureQualityCombo">
          <property name="toolTip">
           <string>Windows DXGI: capped sizes GPU-scale on D3D11 then CPU-read for LEDs (default 1080p). Native = full-res CPU readback. Never upscales. LED mapping stays CPU.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="backendRow">
        <item>
         <widget class="QLabel" name="backendCaption">
          <property name="text">
           <string>Capture API:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="captureBackendCombo">
          <property name="toolTip">
           <string>Windows only. Auto prefers DXGI (SDR BGRA; HDR formats refuse and fall back). Holds the last DXGI frame on idle/empty updates — switches to GDI only after a sustained stall or access loss, then dwells before retrying DXGI (no flip-flop). DXGI-only / GDI-only lock one API. Linux/macOS always use QScreen::grabWindow (needs Screen Recording on macOS; Wayland may need a portal).</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="audienceGroup">
     <property name="title">
      <string>Audience bias (experiment)</string>
     </property>
     <property name="toolTip">
      <string>Optional. Shapes output toward User layout points (seats) without turning LEDs off — Reach still fills the grid; bias cones brightness. 0 = off. Add User ref points — one per watcher.</string>
     </property>
     <layout class="QVBoxLayout" name="audienceLayout">
      <property name="spacing">
       <number>4</number>
      </property>
      <item>
       <widget class="QLabel" name="audienceHintLabel">
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="text">
         <string>Uses layout points typed User. Reach origin stays the display.</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="audienceBiasRow">
        <item>
         <widget class="QLabel" name="audienceBiasCaption">
          <property name="text">
           <string>Bias:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSlider" name="audienceBiasSlider">
          <property name="maximum">
           <number>100</number>
          </property>
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="toolTip">
           <string>0 = even Reach fill. Higher values cone brightness toward User seats (off-cone stays lit, dimmer). Multi-seat = strongest lobe. Use Reach / softness / wave for coverage and motion.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="audienceBiasLabel">
          <property name="minimumSize">
           <size>
            <width>40</width>
            <height>0</height>
           </size>
          </property>
          <property name="text">
           <string>0%</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
